# Lokální hodnoty pro vývoj na tomto stroji.
# Zkopíruj na .env.local a vyplň. .env.local je gitignored a nikdy se necommituje.
#
# SMTP hodnoty patří do deploy/smtp.env (gitignored), protože je používá
# `make smtp-setup`. Tento soubor drží jen ostatní lokální hodnoty.

# Adresář s privátními testovacími klíči a PKCS#12 (gitignored).
TEST_PKI_DIR=test/certs-private

# Veřejné zrcadlo forku. Pro interní Gitea použij ssh://… v .env.local.
FORK=https://github.com/v1b3coder/docuseal.git

# Brevo sender doména (např. 5000001.brevosend.com); jen pro docs.
BREVO_SENDER_DOMAIN=
